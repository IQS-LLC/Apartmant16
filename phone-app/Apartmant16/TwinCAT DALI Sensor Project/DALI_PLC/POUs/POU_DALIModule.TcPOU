nActualLevel_7 := fbDALI102Dimmer7Switch.nActualLevel;
gvlDALI.aPyActualLevel[7] := nActualLevel_7;

// ── Dimmer 8 — Dining Room (SW 2) ────────────────────────────────────────────
fbDALI102Dimmer8Switch(
    bInitialize          := bInitialize,
    nAddress             := 8,
