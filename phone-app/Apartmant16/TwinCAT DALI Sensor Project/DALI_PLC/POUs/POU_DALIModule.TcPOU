nActualLevel_5 := fbDALI102Dimmer5Switch.nActualLevel;
gvlDALI.aPyActualLevel[5] := nActualLevel_5;

// ── Dimmer 6 — Dining Room (SW 2) ────────────────────────────────────────────
fbDALI102Dimmer6Switch(
    bInitialize          := bInitialize,
    nAddress             := 6,
    eAddressType         := E_DALIAddressType.Short,
    bSwitch              := gvlDALI.aSwitch[2],
    bOff                 := gvlIO.bLockdownActive,
