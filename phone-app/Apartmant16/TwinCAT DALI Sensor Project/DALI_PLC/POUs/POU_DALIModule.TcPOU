// ── Dimmer 16 — Hallway (SW 6) ───────────────────────────────────────────────
fbDALI102Dimmer16Switch(
    bInitialize          := bInitialize,
    nAddress             := 16,
    eAddressType         := E_DALIAddressType.Short,
    bSwitch              := gvlDALI.aSwitch[6],
    bOff                 := gvlIO.bLockdownActive,
    bSetLevel            := bSetLevel_16,
    nLevel               := nLevel_16,
    nLevelMemoryMode     := nLevelMemoryMode,
    tCycleActualLevel    := tCycleActualLevel,
    nOptions             := nOptions
);
nActualLevel_16 := fbDALI102Dimmer16Switch.nActualLevel;
gvlDALI.aPyActualLevel[16] := nActualLevel_16;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
