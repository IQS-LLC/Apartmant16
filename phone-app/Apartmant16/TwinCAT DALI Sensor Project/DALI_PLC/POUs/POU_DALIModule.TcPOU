nActualLevel_6 := fbDALI102Dimmer6Switch.nActualLevel;
gvlDALI.aPyActualLevel[6] := nActualLevel_6;

// ── Dimmer 7 — Dining Room (SW 2) ────────────────────────────────────────────
fbDALI102Dimmer7Switch(
    bInitialize          := bInitialize,
    nAddress             := 7,
    eAddressType         := E_DALIAddressType.Short,
    bSwitch              := gvlDALI.aSwitch[2],
    bOff                 := gvlIO.bLockdownActive,
    bSetLevel            := bSetLevel_7,
    nLevel               := nLevel_7,
    nLevelMemoryMode     := nLevelMemoryMode,
