);
nActualLevel_8 := fbDALI102Dimmer8Switch.nActualLevel;
gvlDALI.aPyActualLevel[8] := nActualLevel_8;

// ── Dimmer 9 — Bedroom 1 (SW 3) ──────────────────────────────────────────────
fbDALI102Dimmer9Switch(
    bInitialize          := bInitialize,
    nAddress             := 9,
    eAddressType         := E_DALIAddressType.Short,
    bSwitch              := gvlDALI.aSwitch[3],
    bOff                 := gvlIO.bLockdownActive,
    bSetLevel            := bSetLevel_9,
    nLevel               := nLevel_9,
    nLevelMemoryMode     := nLevelMemoryMode,
    tCycleActualLevel    := tCycleActualLevel,
    nOptions             := nOptions
);
nActualLevel_9 := fbDALI102Dimmer9Switch.nActualLevel;
gvlDALI.aPyActualLevel[9] := nActualLevel_9;

// ── Dimmer 10 — Bedroom 1 (SW 3) ─────────────────────────────────────────────
fbDALI102Dimmer10Switch(
    bInitialize          := bInitialize,
    nAddress             := 10,
    eAddressType         := E_DALIAddressType.Short,
    bSwitch              := gvlDALI.aSwitch[3],
    bOff                 := gvlIO.bLockdownActive,
    bSetLevel            := bSetLevel_10,
    nLevel               := nLevel_10,
    nLevelMemoryMode     := nLevelMemoryMode,
    tCycleActualLevel    := tCycleActualLevel,
    nOptions             := nOptions
);
nActualLevel_10 := fbDALI102Dimmer10Switch.nActualLevel;
gvlDALI.aPyActualLevel[10] := nActualLevel_10;

// ── Dimmer 11 — Bedroom 2 (SW 4) ─────────────────────────────────────────────
fbDALI102Dimmer11Switch(
    bInitialize          := bInitialize,
    nAddress             := 11,
    eAddressType         := E_DALIAddressType.Short,
    bSwitch              := gvlDALI.aSwitch[4],
    bOff                 := gvlIO.bLockdownActive,
    bSetLevel            := bSetLevel_11,
    nLevel               := nLevel_11,
    nLevelMemoryMode     := nLevelMemoryMode,
    tCycleActualLevel    := tCycleActualLevel,
    nOptions             := nOptions
);
nActualLevel_11 := fbDALI102Dimmer11Switch.nActualLevel;
gvlDALI.aPyActualLevel[11] := nActualLevel_11;

// ── Dimmer 12 — Bedroom 2 (SW 4) ─────────────────────────────────────────────
fbDALI102Dimmer12Switch(
    bInitialize          := bInitialize,
    nAddress             := 12,
    eAddressType         := E_DALIAddressType.Short,
    bSwitch              := gvlDALI.aSwitch[4],
    bOff                 := gvlIO.bLockdownActive,
    bSetLevel            := bSetLevel_12,
    nLevel               := nLevel_12,
    nLevelMemoryMode     := nLevelMemoryMode,
    tCycleActualLevel    := tCycleActualLevel,
    nOptions             := nOptions
);
nActualLevel_12 := fbDALI102Dimmer12Switch.nActualLevel;
gvlDALI.aPyActualLevel[12] := nActualLevel_12;

// ── Dimmer 13 — Kitchen (SW 5) ───────────────────────────────────────────────
fbDALI102Dimmer13Switch(
    bInitialize          := bInitialize,
    nAddress             := 13,
    eAddressType         := E_DALIAddressType.Short,
    bSwitch              := gvlDALI.aSwitch[5],
    bOff                 := gvlIO.bLockdownActive,
    bSetLevel            := bSetLevel_13,
    nLevel               := nLevel_13,
    nLevelMemoryMode     := nLevelMemoryMode,
    tCycleActualLevel    := tCycleActualLevel,
    nOptions             := nOptions
);
nActualLevel_13 := fbDALI102Dimmer13Switch.nActualLevel;
gvlDALI.aPyActualLevel[13] := nActualLevel_13;

// ── Dimmer 14 — Kitchen (SW 5) ───────────────────────────────────────────────
fbDALI102Dimmer14Switch(
    bInitialize          := bInitialize,
    nAddress             := 14,
    eAddressType         := E_DALIAddressType.Short,
    bSwitch              := gvlDALI.aSwitch[5],
    bOff                 := gvlIO.bLockdownActive,
    bSetLevel            := bSetLevel_14,
    nLevel               := nLevel_14,
    nLevelMemoryMode     := nLevelMemoryMode,
    tCycleActualLevel    := tCycleActualLevel,
    nOptions             := nOptions
);
nActualLevel_14 := fbDALI102Dimmer14Switch.nActualLevel;
gvlDALI.aPyActualLevel[14] := nActualLevel_14;

// ── Dimmer 15 — Hallway (SW 6) ───────────────────────────────────────────────
fbDALI102Dimmer15Switch(
    bInitialize          := bInitialize,
    nAddress             := 15,
    eAddressType         := E_DALIAddressType.Short,
    bSwitch              := gvlDALI.aSwitch[6],
    bOff                 := gvlIO.bLockdownActive,
    bSetLevel            := bSetLevel_15,
    nLevel               := nLevel_15,
    nLevelMemoryMode     := nLevelMemoryMode,
    tCycleActualLevel    := tCycleActualLevel,
