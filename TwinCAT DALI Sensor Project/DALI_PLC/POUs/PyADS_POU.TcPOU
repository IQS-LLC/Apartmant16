    <Implementation>
      <ST><![CDATA[// This POU is not called from MAIN — kept as documentation only.
// (Previously referenced gvlDALI.aWallRelay, which was never declared;
// that would fail a project build. The actual relay app-bridge now lives
// in WallLight_POU, which reads/writes aPyWallRelay/aPyWallRelayState
// directly against gvlDALI_State.bLightStateN.)

// ── DALI: App → Dimmer levels — NOT YET WIRED ─────────────────────────────
// gvlDALI.aPyLevel[1..28] / aPySetLevel[1..28] are declared but unconnected.
// POU.TcPOU is a graphical CFC; wire these into each fbDALI102DimmerNSwitch
// block's bSetLevel/nLevel input pins in the TwinCAT CFC editor, and wire
// aPyActualLevel[N] from each block's nActualLevel output.]]></ST>
    </Implementation>
